PORT=3000

# Full MongoDB connection string. The database name ("resume-builder") is set by
# the server, so an Atlas string ending in "/?retryWrites=true&w=majority" is fine.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

JWT_SECRET=change-me

IMAGEKIT_PRIVATE_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
